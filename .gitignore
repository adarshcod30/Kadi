# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# Build outputs
dist/
build/
.vite/
client/dist/
*.tsbuildinfo

# Environment & secrets (NEVER commit)
.env
.env.local
.env.*.local
*.pem
.catalyst/
# Local project binding written by `catalyst project:use` — machine-specific, not secret.
.catalystrc

# NOTE: functions/*/catalyst-config.json and appsail/app-config.json are deploy
# manifests and MUST be committed — deploy fails without them. Keep their
# env_variables free of secrets; real values go in the Catalyst console.

# Generated data (large, regenerable via generate.py / run_pipeline.py).
# Keep only the small spec artifacts: _ground_truth.json, _manifest.json.
data/output/*.csv
data/output/rag/*.pdf
data/output/derived/

# Logs
*.log
npm-debug.log*
logs/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
Thumbs.db

# Coverage
coverage/
.nyc_output/

# Deck build artefacts (the .pptx itself is committed; its scaffolding is not)
deck/node_modules/
deck/unpacked/
deck/template.pptx
deck/_t.*
