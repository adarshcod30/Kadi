# KADI environment configuration (copy to .env — .env is gitignored)
# ---------------------------------------------------------------------------
# Backend mode: "mock" runs everything locally against generated CSVs / computed
# graph JSON (no Catalyst needed). "catalyst" uses the real Catalyst SDK adapters.
KADI_BACKEND=mock

# ---- Catalyst project (fill after `catalyst login` + `catalyst init`) ----
CATALYST_PROJECT_ID=55468000000013048
CATALYST_PROJECT_NAME=KadiLabs
CATALYST_ORG_ID=
CATALYST_ENV_ID=
# Data-center domain: zoho.in | zoho.com | zoho.eu ...
CATALYST_DC_DOMAIN=zoho.in

# ---- QuickML (LLM GLM-4.7 + RAG) — Phase 4 ----
QUICKML_LLM_ENDPOINT=
QUICKML_LLM_DEPLOYMENT_ID=
QUICKML_RAG_KB_ID=
QUICKML_CONNECTION_NAME=quickml_conn

# ---- Zia Services (STT / TTS / translation) — Phase 4 ----
ZIA_ENABLED=false
ZIA_KANNADA_STT=false
ZIA_KANNADA_TTS=false

# ---- Local dev server ----
API_PORT=9000
DATA_DIR=./data/output

# ---- Frontend (Vite) ----
VITE_API_BASE=http://localhost:9000
VITE_BACKEND=mock
