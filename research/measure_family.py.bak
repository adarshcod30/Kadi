"""
measure_family.py — the third sweep, and the one that decides what else gets trained.

The first two sweeps measured on research prototypes with their own panel-building code.
That was a mistake worth naming: when the 30-day horizon was re-measured on the SHIPPED
file with a true time-ordered split it fell from +0.130 to +0.028 and had to be rejected.
A number measured on a dataset nobody trains on is describing a different problem.

So everything here is measured on a panel rebuilt to offender_set.py's exact parameters
(warm-up 365 days, 30-day cadence, stop a full horizon before the corpus ends, repeat
offenders with 2+ cases), split on the observation DATE, scored against the best simple
rule available on the same information.

    horizons        will they be back within 30 / 90 / 180 / 365 days
    families        will their NEXT case be a Body / Property / Women crime specifically
    escalation      will their next case be HEINOUS
    new ground      will their next case be in a district they have not worked before

The families are the interesting question the horizon family cannot answer: a property
crime unit does not want everyone who is coming back, it wants the ones coming back with
a burglary. Same offender population, different operational list.
"""
import json
import os
from datetime import date, timedelta

import numpy as np
import pandas as pd
from sklearn.metrics import roc_auc_score, average_precision_score
import lightgbm as lgb

HERE = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(HERE, "..", "data", "output")
DERIVED = os.path.join(HERE, "..", "functions", "api", "data", "derived")
BANNED = {"ReligionID", "CasteID", "OccupationID"}

WARMUP_DAYS, STEP_DAYS, HORIZON_DAYS = 365, 30, 180
FEAT = ["prior_cases", "days_since_last", "span_days", "rate_per_yr",
        "n_districts", "n_heads", "heinous"]
assert not BANNED.intersection(set(FEAT))

cases = pd.read_csv(os.path.join(DATA, "CaseMaster.csv"), low_memory=False)
units = pd.read_csv(os.path.join(DATA, "Unit.csv"), low_memory=False)
cases["reg"] = pd.to_datetime(cases["CrimeRegisteredDate"], errors="coerce")
cases["did"] = cases["PoliceStationID"].astype(str).map(
    dict(zip(units["UnitID"].astype(str), units["DistrictID"].astype(str))))
reg_of = dict(zip(cases["CaseMasterID"].astype(str), cases["reg"]))
did_of = dict(zip(cases["CaseMasterID"].astype(str), cases["did"]))
head_of = dict(zip(cases["CaseMasterID"].astype(str), cases["CrimeMajorHeadID"].astype(str)))
grav_of = dict(zip(cases["CaseMasterID"].astype(str), cases["GravityOffenceID"].astype(str)))
offs = json.load(open(os.path.join(DERIVED, "offenders.json")))

first_day, last_day = cases["reg"].min(), cases["reg"].max()
start = first_day + timedelta(days=WARMUP_DAYS)
end = last_day - timedelta(days=HORIZON_DAYS)
obs = []
t = start
while t <= end:
    obs.append(t); t += timedelta(days=STEP_DAYS)
print(f"corpus {first_day.date()} .. {last_day.date()}   observation dates {len(obs)}")

repeat = [o for o in offs if len({str(c) for c in o.get("caseIds", [])}) >= 2]
print(f"repeat offenders (2+ cases): {len(repeat):,} of {len(offs):,} identities")

rows = []
for o in repeat:
    paired = sorted((reg_of[str(c)], str(c)) for c in o.get("caseIds", []) if reg_of.get(str(c)) is not None)
    if not paired:
        continue
    for t in obs:
        prior = [(d, c) for d, c in paired if d <= t]
        if not prior:
            continue
        fut = [(d, c) for d, c in paired if (d - t).days > 0]
        ids = [c for _, c in prior]
        span = (t - prior[0][0]).days
        nxt = min(fut) if fut else None
        rows.append({
            "t": t,
            "prior_cases": len(prior),
            "days_since_last": (t - prior[-1][0]).days,
            "span_days": span,
            "rate_per_yr": round(len(prior) / max(1.0, span / 365.25), 4),
            "n_districts": len({did_of.get(c) for c in ids if did_of.get(c)}),
            "n_heads": len({head_of.get(c) for c in ids if head_of.get(c)}),
            "heinous": sum(1 for c in ids if grav_of.get(c) == "1"),
            "_gap": (nxt[0] - t).days if nxt else 10 ** 6,
            "_nhead": head_of.get(nxt[1]) if nxt else None,
            "_ngrav": grav_of.get(nxt[1]) if nxt else None,
            "_ndid": did_of.get(nxt[1]) if nxt else None,
            "_seen_dids": {did_of.get(c) for c in ids if did_of.get(c)},
        })
P = pd.DataFrame(rows).sort_values("t").reset_index(drop=True)
print(f"panel rows {len(P):,}   offenders {len(repeat):,}\n")

# Split on the observation DATE, not the row index: every row dated after the cut is
# unseen, and no offender's future leaks backwards through a shared date.
CUT = pd.Series(obs).quantile(0.75)
print(f"time-ordered split at {CUT.date()}  "
      f"(train {int((P['t'] <= CUT).sum()):,} rows / test {int((P['t'] > CUT).sum()):,} rows)\n")

RESULTS = []


def measure(key, name, y, note=""):
    g = P.copy(); g["y"] = y.astype(int)
    tr, te = g[g["t"] <= CUT], g[g["t"] > CUT]
    if te["y"].nunique() < 2 or tr["y"].nunique() < 2 or te["y"].sum() < 25:
        print(f"  {key:12} {name:44} SKIP (only {int(te['y'].sum())} test positives)")
        return
    m = lgb.LGBMClassifier(n_estimators=400, learning_rate=0.05, num_leaves=15,
                           min_child_samples=25, subsample=0.9, colsample_bytree=0.8,
                           verbose=-1, random_state=7)
    m.fit(tr[FEAT], tr["y"])
    p = m.predict_proba(te[FEAT])[:, 1]
    rules = {"recency": -te["days_since_last"], "rate/yr": te["rate_per_yr"],
             "prior cases": te["prior_cases"], "n_heads": te["n_heads"]}
    scored = {k: roc_auc_score(te["y"], v) for k, v in rules.items()}
    best = max(scored, key=scored.get)
    auc, base = roc_auc_score(te["y"], p), scored[best]
    ap, apb = average_precision_score(te["y"], p), average_precision_score(te["y"], rules[best])
    win = auc > base and ap > apb
    RESULTS.append((key, name, len(g), g["y"].mean(), auc, base, best, auc - base, win, note))
    print(f"  {key:12} {name:44} model {auc:.3f}  best rule ({best}) {base:.3f}   "
          f"margin {auc - base:+.3f}  ap {ap:.3f}/{apb:.3f}  {'WINS' if win else 'loses'}")


print("HORIZONS — will they be back at all")
for h in (30, 90, 180, 365):
    measure(f"h{h}", f"back within {h} days", P["_gap"] <= h)

print("\nFAMILIES — what they come back WITH (next case's major head)")
NAMES = {"1": "Body", "2": "Property", "3": "Women", "4": "Economic", "5": "Cyber"}
for hid, hname in NAMES.items():
    for h in (180, 365):
        measure(f"{hname[:4].lower()}{h}", f"next case is {hname}, within {h} days",
                (P["_gap"] <= h) & (P["_nhead"] == hid))

print("\nSEVERITY — will the next one be heinous")
for h in (180, 365):
    measure(f"hein{h}", f"next case is Heinous, within {h} days",
            (P["_gap"] <= h) & (P["_ngrav"] == "1"))

print("\nGEOGRAPHY — will they surface somewhere new")
for h in (180, 365):
    measure(f"new{h}", f"next case in an unworked district, within {h} days",
            (P["_gap"] <= h) & P.apply(lambda r: r["_ndid"] is not None
                                       and r["_ndid"] not in r["_seen_dids"], axis=1))

print("\n" + "=" * 100)
print(f"{'key':12} {'verdict':8} {'rate':>7} {'model':>7} {'rule':>7} {'margin':>8}  task")
for key, name, n, rate, auc, base, best, margin, win, note in RESULTS:
    print(f"{key:12} {'SHIP' if win else 'drop':8} {rate:6.1%} {auc:7.3f} {base:7.3f} {margin:+8.3f}  {name}")
